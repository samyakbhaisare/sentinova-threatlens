# Generate local-only random values with python scripts/bootstrap.py.
# Production: inject from secret manager; do not commit .env or secrets/.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://localhost:6380/0
SEARCH_URL=http://localhost:9201
JWT_SECRET=
JWT_SECRET_FILE=
ENCRYPTION_KEY=
ENCRYPTION_KEY_FILE=
ORIGIN=http://localhost:3000
PRODUCTION=false
AUTOMATIC_ENRICHMENT=true
# Enable only after confirming geolocation-provider usage entitlement.
GEOLOCATION_ENABLED=false
SEARCH_INDEX=threatlens
REPORT_DIR=
SECRETS_DIR=
# Files in SECRETS_DIR: virustotal_key, abuseipdb_key, otx_key, abusech_key.
# Add TAXII hostnames only after operator review and egress policy changes.
FEED_HOSTS=www.cisa.gov,feodotracker.abuse.ch,urlhaus-api.abuse.ch,mb-api.abuse.ch,threatfox-api.abuse.ch,otx.alienvault.com,raw.githubusercontent.com,www.spamhaus.org

# Optional provider endpoint overrides (test servers or an egress proxy).
# VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3/
# ABUSEIPDB_BASE_URL=https://api.abuseipdb.com/api/v2/
# IPWHOIS_BASE_URL=https://ipwho.is/

# Optional database pool tuning.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# Optional Compose overrides (all host ports bind to loopback).
# IMAGE_TAG=verify
# POSTGRES_PORT=5433
# REDIS_PORT=6380
# SEARCH_PORT=9201
# API_PORT=8100
# FRONTEND_PORT=3000
